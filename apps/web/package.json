{
  "name": "@tela/web",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite --config vite.desktop.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node ../../scripts/stamp-build.mjs",
    "build:desktop": "tsc -p tsconfig.json --noEmit && vite build --config vite.desktop.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "deploy": "wrangler pages deploy dist --project-name tela"
  },
  "dependencies": {
    "@tela/shared": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tela/tsconfig": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.11.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
