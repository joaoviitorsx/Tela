# NÃO existe `_redirects` aqui de propósito.
#
# O SPA fallback é feito por `not_found_handling = "single-page-application"`
# no wrangler.toml do Worker. Um `_redirects` com `/* /index.html 200` junto
# disso é recusado pela Cloudflare como laço infinito.
#
# Se você publicar em Cloudflare Pages (em vez do Worker), aí SIM precisa de
# um `_redirects` com essa regra — ver docs/DEPLOY.md.

/*
  # Sem display-capture=(self), getDisplayMedia é bloqueado e o botão
  # TRANSMITIR simplesmente não faz nada.
  Permissions-Policy: display-capture=(self), microphone=(self), camera=(), geolocation=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # O token do canal mora no localStorage: a CSP é a rede contra XSS roubá-lo.
  # script-src 'self' + hash do único <script> inline (preload do .glb em index.html);
  # mudou aquele script => recalcule o hash (node -e sha256 base64) ou a home quebra.
  # style-src 'unsafe-inline': React escreve style= inline e o Tailwind injeta <style>.
  # Google Fonts: CSS em googleapis, arquivos em gstatic. connect-src 'self' cobre o
  # wss://<host>/signal (mesma origem); blob: é o carregador 3D buscando o .glb por
  # object URL. discord.com: o aviso AO VIVO faz fetch do webhook direto do
  # navegador (core/domain/webhook-discord normaliza sempre p/ discord.com).
  # worker-src 'self' blob:: o injecao-worker é bundle local.
  # frame-ancestors 'none' + X-Frame-Options: ninguém embute a tela (clickjack no token).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-+YxjQwL084m7PgKhATRhZgqCojtOYVxkwSQucMN1Hg8='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' blob: https://discord.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O modelo da abertura, que agora carrega em TODA visita à tela inicial
# (ADR 0013). Sem cabeçalho, são 208 KB por visita.
#
# Sete dias e não `immutable`: o nome do arquivo não tem hash de conteúdo — ele
# é referenciado por caminho fixo no `preload` do index.html e no adaptador —,
# então `immutable` por um ano deixaria uma versão velha do modelo presa no
# navegador de quem já visitou. Uma semana some sozinha; `stale-while-revalidate`
# faz a troca acontecer em segundo plano, sem ninguém esperar por ela.
/tela-crt.glb
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
