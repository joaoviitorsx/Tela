# ─── modo SFU (VPS com IP público) ───────────────────────────────────────────
NODE_ENV=production
TELA_TRANSPORT=sfu
API_HOST=127.0.0.1
API_PORT=3333
PUBLIC_BASE_URL=https://tela.gg
MAX_VIEWERS=12
LOG_LEVEL=info
TRUST_PROXY=true

TELA_STORE=redis
REDIS_URL=redis://127.0.0.1:6379

# Iguais aos de infra/livekit/livekit.yaml. Gere com: openssl rand -base64 36
LIVEKIT_API_KEY=APIchangeme
LIVEKIT_API_SECRET=
# Interno: como a API fala com o LiveKit.
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
# Público: o que o browser recebe. Atrás do Caddy é wss://<dominio>/rtc.
LIVEKIT_WS_URL=wss://tela.gg/rtc
