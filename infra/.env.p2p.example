# ─── modo P2P (self-host na sua própria rede/máquina) ────────────────────────
#
# Sem LiveKit, sem Redis. O servidor só assina tickets e roteia SDP/ICE;
# o vídeo vai direto de browser para browser.
NODE_ENV=production
TELA_TRANSPORT=p2p
API_HOST=127.0.0.1
API_PORT=3333
PUBLIC_BASE_URL=https://tela.seudominio.com
LOG_LEVEL=info
TRUST_PROXY=true

# Sem REDIS_URL o estado fica em memória. Basta para um host doméstico: o que
# se perde num restart é a reserva do slug, e o transmissor recupera com um POST.
TELA_STORE=memory

# HMAC dos tickets de sinalização. Gere com: openssl rand -base64 36
SIGNAL_SECRET=

# WebSocket público de sinalização, entregue ao browser.
SIGNAL_WS_URL=wss://tela.seudominio.com/api/signal

# Teto de espectadores. Cada espectador é um encoder na máquina do transmissor
# E uma cópia do upstream saindo da casa dele. Subir daqui derruba o FPS do jogo
# antes de derrubar a rede. Ver docs/adr/0002.
P2P_MAX_VIEWERS=3

STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# TURN — obrigatório se você ou seus amigos estiverem atrás de CGNAT.
# Sem isto, uma fração das conexões simplesmente não fecha. Ver
# docs/SELF-HOSTING.md, seção CGNAT.
# TURN_URL=turn:turn.seudominio.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=
