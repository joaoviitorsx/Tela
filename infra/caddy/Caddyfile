{$DOMAIN:tela.gg}, www.{$DOMAIN:tela.gg} {
    encode zstd gzip

    # WebSocket de signaling do LiveKit (modo SFU).
    handle /rtc* {
        uri strip_prefix /rtc
        reverse_proxy 127.0.0.1:7880
    }

    # API + WebSocket de sinalização do modo P2P (/api/signal).
    # O Caddy faz upgrade de WebSocket sozinho desde a v2.
    handle /api/* {
        reverse_proxy 127.0.0.1:3333
    }

    handle {
        root * /srv/web
        # SPA: /:slug precisa cair no index.html, senão tela.gg/joao dá 404.
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        # Sem display-capture=(self), getDisplayMedia é bloqueado em alguns
        # contextos e o botão TRANSMITIR simplesmente não faz nada.
        Permissions-Policy "display-capture=(self), microphone=(self), camera=(), geolocation=(), interest-cohort=()"
        -Server
    }

    log {
        output file /var/log/caddy/tela.log
        format json
        # Retenção curta: IP é dado pessoal (§15).
        }
}
