{
  "name": "tela",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "turbo lint typecheck test build",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "e2e": "node e2e/mesh.e2e.mjs",
    "prod": "node scripts/check-prod.mjs",
    "release": "pnpm --filter @tela/shared build && pnpm --filter @tela/web build && pnpm --filter @tela/signaling build && node scripts/check-deploy.mjs && pnpm --filter @tela/signaling exec wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "playwright": "^1.62.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
